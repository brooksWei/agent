# Default model provider: gemini | deepseek
MODEL_PROVIDER=deepseek

# Gemini
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-3-pro-preview
GEMINI_EMBEDDING_MODEL=text-embedding-004

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING_MODE=disabled

# Outbound proxy for overseas model APIs
MODEL_PROXY_ENABLED=true
MODEL_PROXY_URL=http://127.0.0.1:7890

MILVUS_URL=http://127.0.0.1:19530
MILVUS_COLLECTION=agent_memory_gemini
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_SSL=false
MILVUS_OPERATION_TIMEOUT_MS=1200

# MCP server list file (relative or absolute path)
MCP_SERVERS_FILE=./mcp.servers.json
