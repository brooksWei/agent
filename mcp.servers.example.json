[
  {
    "name": "filesystem",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
  },
  {
    "name": "mastergo_magic_mcp",
    "command": "npx",
    "args": ["-y", "@mastergo/magic-mcp"],
    "env": {
      "MG_MCP_TOKEN": "YOUR_MASTERGO_TOKEN",
      "API_BASE_URL": "https://mastergo.com"
    }
  },
  {
    "name": "playwright_mcp",
    "command": "npx",
    "args": [
      "-y",
      "@playwright/mcp",
      "--isolated",
      "--headless",
      "--allowed-hosts",
      "localhost,127.0.0.1"
    ]
  }
]
